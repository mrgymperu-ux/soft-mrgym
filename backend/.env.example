# Copiar este archivo a ".env" y completar los valores reales.
# El archivo .env NO debe subirse a git (agregar a .gitignore).

# Conexion a base de datos.
# Si se omite, el sistema usa SQLite local (sql_app.db) automaticamente,
# util para desarrollo sin configurar nada.
# Para produccion con Postgres (Supabase/Neon), usar algo asi:
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL=

# Clave secreta para firmar los tokens JWT. OBLIGATORIO definir una
# propia y unica antes de desplegar a produccion real. Se puede
# generar una rapido en Python con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales del usuario administrador inicial, creado solo la
# primera vez que se ejecuta init_db.py (si ya existe algun usuario,
# no se crea de nuevo). Cambiar estos valores antes de producir.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_NOMBRE=Administrador

# Pago online de la suscripcion SaaS via Izipay (checkout incrustado).
# Se obtienen en Back Office Vendedor > Configuracion > Tienda > Claves
# de la API REST. Hay un juego de claves TEST y otro PRODUCTION; usar
# el que corresponda a este ambiente.
# 1) Usuario (ID de tienda, "usuario" de la tabla de claves)
IZIPAY_SHOP_ID=
# 2) Password (para autenticar llamadas REST y firmar la IPN)
IZIPAY_PASSWORD=
# 3) Clave publica (segura para el frontend, arma el formulario)
IZIPAY_PUBLIC_KEY=
# 4) Clave HMAC-SHA-256 (firma el retorno del comprador a la tienda,
#    es DISTINTA del password usado en la IPN)
IZIPAY_HMAC_KEY=
# Opcional: cambiar solo si Izipay indica otra URL base para la API
# IZIPAY_API_BASE=https://api.micuentaweb.pe/api-payment/V4
